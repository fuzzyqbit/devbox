#!/usr/bin/env bash
set -euo pipefail

# --------------------------------------------------------------------------
# Color output helpers (POL-01)
# Bash 3.2-compatible — placed before the bash 4+ guard so doctor can use them.
# NO_COLOR spec: https://no-color.org/
# CI: GitLab sets CI=true automatically; suppress color in CI.
# --------------------------------------------------------------------------
if [[ -n "${NO_COLOR:-}" ]] || [[ "${CI:-}" == "true" ]]; then
  RED=""
  GREEN=""
  YELLOW=""
  BOLD=""
  RESET=""
else
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  YELLOW=$'\033[1;33m'
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
fi

_info()  { echo "${GREEN}[INFO]${RESET} $*"; }
_warn()  { echo "${YELLOW}[WARN]${RESET} $*" >&2; }
_error() { echo "${RED}ERROR:${RESET} $*" >&2; }

# --------------------------------------------------------------------------
# Doctor command and helpers (POL-02)
# All code in this section is bash 3.2-compatible: no associative arrays,
# no ${var,,} lowercase, no |& pipe, no readarray/mapfile.
# --------------------------------------------------------------------------

_get_version() {
  local cmd="$1"
  local raw=""
  # Each branch captures raw output with || true to handle non-zero exits.
  # Post-processing pipes use || true on grep to handle no-match under pipefail.
  case "$cmd" in
    aws)
      raw="$(aws --version 2>&1 | head -1)" || true
      echo "$raw" | awk -F'[/ ]' '{print $2}'
      ;;
    packer)
      raw="$(packer --version 2>&1)" || true
      echo "$raw" | sed 's/.*v//' | head -1
      ;;
    tofu)
      raw="$(tofu --version 2>&1)" || true
      echo "$raw" | sed 's/.*v//' | head -1
      ;;
    ansible)
      raw="$(ansible --version 2>&1 | head -1)" || true
      echo "$raw" | sed 's/.*\[core //' | sed 's/\].*//'
      ;;
    ansible-lint)
      raw="$(ansible-lint --version 2>&1)" || true
      echo "$raw" | { grep -E '^ansible-lint' || true; } | head -1 | awk '{print $2}'
      ;;
    shellcheck)
      raw="$(shellcheck --version 2>&1)" || true
      echo "$raw" | { grep '^version:' || true; } | awk '{print $2}'
      ;;
    gitleaks)
      raw="$(gitleaks version 2>&1)" || true
      echo "${raw#v}"
      ;;
    pre-commit)
      raw="$(pre-commit --version 2>&1)" || true
      echo "$raw" | awk '{print $2}'
      ;;
    *)
      echo "unknown"
      ;;
  esac
}

_check_cmd() {
  local cmd="$1" install_hint="$2" min_major="${3:-}"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "  ${RED}FAIL${RESET}  $cmd -- not found (install: $install_hint)"
    fail=$((fail + 1))
    return
  fi
  if [[ -n "$min_major" ]]; then
    local ver
    ver="$(_get_version "$cmd")"
    local major="${ver%%.*}"
    if [[ "$major" -lt "$min_major" ]] 2>/dev/null; then
      echo "  ${YELLOW}WARN${RESET}  $cmd -- version $ver (need >= $min_major)"
      warn=$((warn + 1))
      return
    fi
  fi
  echo "  ${GREEN}OK${RESET}    $cmd"
  pass=$((pass + 1))
}

_check_cmd_optional() {
  local cmd="$1" install_hint="$2" min_major="${3:-}"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "  ${YELLOW}SKIP${RESET}  $cmd -- not found, optional (install: $install_hint)"
    warn=$((warn + 1))
    return
  fi
  if [[ -n "$min_major" ]]; then
    local ver
    ver="$(_get_version "$cmd")"
    local major="${ver%%.*}"
    if [[ "$major" -lt "$min_major" ]] 2>/dev/null; then
      echo "  ${YELLOW}WARN${RESET}  $cmd -- version $ver (need >= $min_major)"
      warn=$((warn + 1))
      return
    fi
  fi
  echo "  ${GREEN}OK${RESET}    $cmd"
  pass=$((pass + 1))
}

cmd_doctor() {
  local pass=0 fail=0 warn=0

  _info "Checking required dependencies..."
  echo ""

  _check_cmd "aws" "brew install awscli" "2"
  _check_cmd "packer" "brew install packer" "1"
  _check_cmd "tofu" "brew install opentofu" "1"
  _check_cmd "ansible" "brew install ansible" ""
  _check_cmd "ansible-lint" "pip install ansible-lint" "26"
  _check_cmd "jq" "brew install jq" ""
  _check_cmd "shellcheck" "brew install shellcheck" "0"
  _check_cmd "gitleaks" "brew install gitleaks" "8"
  _check_cmd "pre-commit" "pip install pre-commit" "4"
  _check_cmd "session-manager-plugin" "brew install --cask session-manager-plugin" ""

  echo ""
  echo "${BOLD}Optional dependencies:${RESET}"
  echo ""

  _check_cmd_optional "checkov" "pip install checkov" ""

  # Check bash version (warn if < 4, since doctor itself works on 3.2)
  echo ""
  echo "${BOLD}Shell:${RESET}"
  echo ""
  if [[ "${BASH_VERSINFO[0]}" -lt 4 ]]; then
    echo "  ${YELLOW}WARN${RESET}  bash -- version ${BASH_VERSION} (need >= 4.0 for all commands; brew install bash)"
    warn=$((warn + 1))
  else
    echo "  ${GREEN}OK${RESET}    bash -- version ${BASH_VERSION}"
    pass=$((pass + 1))
  fi

  echo ""
  echo "${BOLD}Summary:${RESET} ${pass} passed, ${fail} failed, ${warn} warnings"
  if [[ "$fail" -gt 0 ]]; then
    exit 1
  fi
}

# --------------------------------------------------------------------------
# Doctor mini-dispatch (runs BEFORE bash 4+ guard — POL-02, Pitfall 1)
# --------------------------------------------------------------------------
if [[ "${1:-}" == "doctor" ]]; then
  cmd_doctor
  exit 0
fi

# --------------------------------------------------------------------------
# Bash 4+ guard (protects all other commands — RUN-06, STACK.md)
# --------------------------------------------------------------------------
if [[ "${BASH_VERSINFO[0]}" -lt 4 ]]; then
  _error "Bash 4+ required. macOS: brew install bash"
  exit 1
fi

# --------------------------------------------------------------------------
# REPO_ROOT anchor (Pitfall M-3: never use bare cd)
# --------------------------------------------------------------------------
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --------------------------------------------------------------------------
# Variable defaults (formerly mirrored the Makefile; now the sole source)
# --------------------------------------------------------------------------
DEVBOX_USER="${DEVBOX_USER:-}"
TF_BIN="${TF_BIN:-tofu}"
TF_STATE_REGION="${TF_STATE_REGION:-us-east-1}"
TF_STATE_LOCK_TABLE="${TF_STATE_LOCK_TABLE:-devimage-tfstate-locks}"
DEVBOX_FORWARD_DEFAULT_PORT="${DEVBOX_FORWARD_DEFAULT_PORT:-8080}"
INSTANCE_ID="${INSTANCE_ID:-}"
REGION="${REGION:-}"
# TF_STATE_BUCKET is NOT derived at startup — computed lazily by
# _derive_tf_state_bucket (Pitfall C-1, ARCHITECTURE.md anti-pattern).

# --------------------------------------------------------------------------
# Guard functions
# --------------------------------------------------------------------------

_require_devbox_user() {
  if [[ -z "$DEVBOX_USER" ]]; then
    _error "DEVBOX_USER is not set."
    echo "       Set per-invocation:  DEVBOX_USER=jsmith ./run <command>" >&2
    echo "       Or in your shell:    export DEVBOX_USER=jsmith" >&2
    exit 1
  fi
  if [[ ! "$DEVBOX_USER" =~ ^[a-z0-9][a-z0-9-]{0,30}[a-z0-9]$ ]]; then
    _error "DEVBOX_USER='${DEVBOX_USER}' is invalid."
    echo "       Must be lowercase alphanumeric + dash, 2-32 chars, no leading/trailing dash." >&2
    exit 1
  fi
}

_derive_tf_state_bucket() {
  # Respect operator override (Pitfall C-1).
  if [[ -n "${TF_STATE_BUCKET:-}" ]]; then
    return
  fi
  local account_id
  account_id="$(aws sts get-caller-identity --query Account --output text 2>/dev/null || true)"
  if [[ -z "$account_id" ]] || [[ "devimage-tfstate-${account_id}" == "devimage-tfstate-" ]]; then
    _error "could not resolve AWS account ID via 'aws sts get-caller-identity'."
    echo "       Check your AWS credentials/profile, or set TF_STATE_BUCKET=... explicitly." >&2
    exit 1
  fi
  TF_STATE_BUCKET="devimage-tfstate-${account_id}"
}

_tf_state_key() {
  echo "users/${DEVBOX_USER}/devbox.tfstate"
}

_tf_backend_args() {
  _derive_tf_state_bucket
  local key
  key="$(_tf_state_key)"
  echo "-backend-config=bucket=${TF_STATE_BUCKET}" \
       "-backend-config=key=${key}" \
       "-backend-config=region=${TF_STATE_REGION}" \
       "-backend-config=dynamodb_table=${TF_STATE_LOCK_TABLE}"
}

_tf_var_args() {
  echo "-var" "devbox_user=${DEVBOX_USER}" "-var" "key_name=${DEVBOX_USER}-devbox"
}

# --------------------------------------------------------------------------
# Group A — Packer (no DEVBOX_USER guard needed)
# --------------------------------------------------------------------------

cmd_packer_init() {
  (cd "$REPO_ROOT/packer" && packer init .)
}

cmd_validate() {
  cmd_packer_init
  (cd "$REPO_ROOT/packer" && packer validate .)
  (cd "$REPO_ROOT/terraform" && "$TF_BIN" validate)
}

cmd_build() {
  cmd_packer_init
  (cd "$REPO_ROOT/packer" && packer build .)
}

cmd_fmt() {
  (cd "$REPO_ROOT/packer" && packer fmt .)
  (cd "$REPO_ROOT/terraform" && "$TF_BIN" fmt)
  echo "Format complete"
}

# --------------------------------------------------------------------------
# Group B — Terraform (need DEVBOX_USER + backend guards)
# --------------------------------------------------------------------------

cmd_tf_ensure_init() {
  _require_devbox_user
  local desired_key
  desired_key="$(_tf_state_key)"
  local cached_key
  cached_key="$(jq -r '.backend.config.key // empty' \
    "$REPO_ROOT/terraform/.terraform/terraform.tfstate" 2>/dev/null || true)"
  if [[ "$cached_key" != "$desired_key" ]]; then
    echo "[tf-ensure-init] backend cache mismatch (cached='${cached_key}', want='${desired_key}'); reinitializing..."
    cmd_tf_reinit
  fi
}

cmd_tf_init() {
  _require_devbox_user
  _derive_tf_state_bucket
  local lockfile_flag=""
  if [[ "${CI:-}" == "true" ]]; then
    lockfile_flag="-lockfile=readonly"
  fi
  # shellcheck disable=SC2046
  (cd "$REPO_ROOT/terraform" && "$TF_BIN" init $lockfile_flag $(_tf_backend_args))
}

cmd_tf_reinit() {
  _require_devbox_user
  _derive_tf_state_bucket
  local lockfile_flag=""
  if [[ "${CI:-}" == "true" ]]; then
    lockfile_flag="-lockfile=readonly"
  fi
  # shellcheck disable=SC2046
  (cd "$REPO_ROOT/terraform" && "$TF_BIN" init -reconfigure $lockfile_flag $(_tf_backend_args))
}

cmd_tf_plan() {
  cmd_tf_ensure_init
  # shellcheck disable=SC2046
  (cd "$REPO_ROOT/terraform" && "$TF_BIN" plan $(_tf_var_args))
}

cmd_tf_apply() {
  cmd_tf_ensure_init
  # shellcheck disable=SC2046
  (cd "$REPO_ROOT/terraform" && "$TF_BIN" apply $(_tf_var_args))
}

cmd_tf_auto_apply() {
  cmd_tf_ensure_init
  # shellcheck disable=SC2046
  (cd "$REPO_ROOT/terraform" && "$TF_BIN" apply -auto-approve $(_tf_var_args))
}

cmd_tf_destroy() {
  cmd_tf_ensure_init
  # shellcheck disable=SC2046
  (cd "$REPO_ROOT/terraform" && "$TF_BIN" destroy $(_tf_var_args))
}

cmd_tf_auto_destroy() {
  cmd_tf_ensure_init
  # shellcheck disable=SC2046
  (cd "$REPO_ROOT/terraform" && "$TF_BIN" destroy -auto-approve $(_tf_var_args))
}

# --------------------------------------------------------------------------
# Group C — Instance lifecycle (delegate to scripts)
# --------------------------------------------------------------------------

cmd_start() {
  cmd_tf_ensure_init
  DEVBOX_USER="$DEVBOX_USER" INSTANCE_ID="$INSTANCE_ID" REGION="$REGION" \
    "$REPO_ROOT/scripts/devbox-start.sh" "$@"
}

cmd_stop() {
  cmd_tf_ensure_init
  DEVBOX_USER="$DEVBOX_USER" INSTANCE_ID="$INSTANCE_ID" REGION="$REGION" \
    "$REPO_ROOT/scripts/devbox-stop.sh" "$@"
}

cmd_status() {
  cmd_tf_ensure_init
  DEVBOX_USER="$DEVBOX_USER" INSTANCE_ID="$INSTANCE_ID" REGION="$REGION" \
    "$REPO_ROOT/scripts/devbox-status.sh" "$@"
}

cmd_wait_ready() {
  cmd_tf_ensure_init
  DEVBOX_USER="$DEVBOX_USER" INSTANCE_ID="$INSTANCE_ID" REGION="$REGION" \
    "$REPO_ROOT/scripts/devbox-wait.sh" "$@"
}

# --------------------------------------------------------------------------
# Group D — SSM access
# --------------------------------------------------------------------------

cmd_devbox_ssm() {
  cmd_tf_ensure_init
  DEVBOX_USER="$DEVBOX_USER" INSTANCE_ID="$INSTANCE_ID" REGION="$REGION" \
    "$REPO_ROOT/scripts/devbox-ssm.sh" "$@"
}

cmd_jupyter() {
  cmd_tf_ensure_init
  DEVBOX_USER="$DEVBOX_USER" INSTANCE_ID="$INSTANCE_ID" REGION="$REGION" \
    "$REPO_ROOT/scripts/devbox-jupyter.sh" "$@"
}

cmd_devbox_port_forward() {
  cmd_tf_ensure_init
  if ! command -v session-manager-plugin >/dev/null 2>&1; then
    _error "session-manager-plugin not installed."
    echo "       macOS:  brew install --cask session-manager-plugin" >&2
    echo "       Linux:  https://docs.aws.amazon.com/systems-manager/latest/userguide/session-manager-working-with-install-plugin.html" >&2
    exit 1
  fi
  local instance_id region
  instance_id="$(cd "$REPO_ROOT/terraform" && "$TF_BIN" output -raw instance_id)"
  region="$(cd "$REPO_ROOT/terraform" && "$TF_BIN" output -raw aws_region)"

  # Port specs: PORT or REMOTE:LOCAL, zero or more. No args = code-server :8080.
  # e.g.  ./run devbox-port-forward            -> 8080
  #       ./run devbox-port-forward 8888:18888 -> remote 8888 on localhost:18888
  # (Amazon DCV :8443 is direct connect within the allowed CIDR — not forwarded.)
  local specs=("$@")
  [ ${#specs[@]} -eq 0 ] && specs=("$DEVBOX_FORWARD_DEFAULT_PORT")

  local spec remote_ports=() local_ports=() remote local_port
  for spec in "${specs[@]}"; do
    remote="${spec%%:*}"
    local_port="${spec##*:}"
    if [[ ! "$remote" =~ ^[0-9]+$ ]] || [[ ! "$local_port" =~ ^[0-9]+$ ]]; then
      _error "invalid port spec '${spec}' (expected PORT or REMOTE:LOCAL, e.g. 8080 or 8888:18888)"
      exit 1
    fi
    remote_ports+=("$remote")
    local_ports+=("$local_port")
  done

  echo "Ctrl-C to stop forwarding."
  if [ ${#remote_ports[@]} -eq 1 ]; then
    echo "Forwarding ${instance_id}:${remote_ports[0]} -> localhost:${local_ports[0]} ..."
    exec aws ssm start-session \
      --target "$instance_id" \
      --region "$region" \
      --document-name AWS-StartPortForwardingSession \
      --parameters "{\"portNumber\":[\"${remote_ports[0]}\"],\"localPortNumber\":[\"${local_ports[0]}\"]}"
  fi

  # Multiple ports: AWS-StartPortForwardingSession is single-port, so run one
  # background session per spec and reap them together on Ctrl-C.
  local pids=() i
  trap 'kill "${pids[@]}" 2>/dev/null' INT TERM
  for i in "${!remote_ports[@]}"; do
    echo "Forwarding ${instance_id}:${remote_ports[$i]} -> localhost:${local_ports[$i]} ..."
    aws ssm start-session \
      --target "$instance_id" \
      --region "$region" \
      --document-name AWS-StartPortForwardingSession \
      --parameters "{\"portNumber\":[\"${remote_ports[$i]}\"],\"localPortNumber\":[\"${local_ports[$i]}\"]}" &
    pids+=("$!")
  done
  wait
}

# --------------------------------------------------------------------------
# Group E — Secrets
# --------------------------------------------------------------------------

cmd_secrets_show() {
  _require_devbox_user
  echo "Resolving secrets for DEVBOX_USER=${DEVBOX_USER}..."
  local cs_pwd desktop_pwd
  local aws_err
  aws_err="$(mktemp)"
  trap 'rm -f "$aws_err"' RETURN
  cs_pwd="$(aws ssm get-parameter \
    --name "/devbox/${DEVBOX_USER}/code-server-password" \
    --with-decryption --query 'Parameter.Value' --output text 2>"$aws_err")" \
    || {
      _error "code-server password not found at /devbox/${DEVBOX_USER}/code-server-password"
      echo "       Run './run build' first to publish secrets to SSM, or check your DEVBOX_USER." >&2
      cat "$aws_err" >&2
      rm -f "$aws_err"
      exit 1
    }
  desktop_pwd="$(aws ssm get-parameter \
    --name "/devbox/${DEVBOX_USER}/desktop-password" \
    --with-decryption --query 'Parameter.Value' --output text 2>"$aws_err")" \
    || {
      _error "DCV login password not found at /devbox/${DEVBOX_USER}/desktop-password"
      cat "$aws_err" >&2
      rm -f "$aws_err"
      exit 1
    }
  rm -f "$aws_err"
  echo ""
  echo "code-server (https://<host>:8080) password:  ${cs_pwd}"
  echo "DCV login (ec2-user @ <host>:8443) password:  ${desktop_pwd}"
  echo ""
  echo "(Secrets are stored as SSM SecureStrings; rotated on every \`./run build\`.)"
}

# --------------------------------------------------------------------------
# Group F — Cleanup
# --------------------------------------------------------------------------

cmd_clean() {
  rm -rf "$REPO_ROOT/packer/packer_cache"
  rm -rf "$REPO_ROOT/terraform/.terraform"
  rm -f "$REPO_ROOT/users/"*.auto.tfvars
}

# --------------------------------------------------------------------------
# Group G — Help (RUN-02)
# --------------------------------------------------------------------------

cmd_help() {
  cat <<EOF
Usage: DEVBOX_USER=username ./run <command>

${BOLD}AMI${RESET}
  packer-init  Install Packer plugins
  validate     Validate Packer and Terraform configs
  build        Build the devimage AMI with Packer
  fmt          Format Packer and Terraform files

${BOLD}Terraform / OpenTofu${RESET} (per-operator state at users/\$DEVBOX_USER/devbox.tfstate)
  tf-init          Init backend for DEVBOX_USER (first-time / after switching user)
  tf-reinit        Re-init with -reconfigure (after backend changes or stale .terraform)
  tf-ensure-init   Auto-reinit if cached backend key mismatches DEVBOX_USER
  tf-plan          Plan changes for DEVBOX_USER
  tf-apply         Apply with confirmation prompt
  tf-auto-apply    Apply without prompt
  tf-destroy       Destroy with confirmation prompt
  tf-auto-destroy  Destroy without prompt

${BOLD}Instance lifecycle${RESET} (override resolution: INSTANCE_ID=i-... REGION=us-east-1)
  start        Start the devbox EC2 instance
  stop         Stop the devbox EC2 instance
  status       Show instance status and connection info
  wait-ready   Wait for a freshly-applied instance to finish building
               (running -> EC2 status-ok -> SSM Online). Run after tf-apply.

${BOLD}SSM access${RESET} (Phase 2 -- replaces public :22 ingress)
  devbox-ssm           Open an SSM Session Manager shell to the devbox
  devbox-port-forward  Forward ports from the devbox over SSM (default :8080).
                       Args: PORT or REMOTE:LOCAL, repeatable.
                       e.g. ./run devbox-port-forward 8080 8888:18888
  jupyter              Launch JupyterLab on demand (127.0.0.1:8888, loopback-only) over SSM

${BOLD}Secrets${RESET}
  secrets-show   Print the operator's code-server and DCV login passwords from SSM

${BOLD}Diagnostics${RESET}
  doctor       Check required dependencies and report missing/version issues

${BOLD}Cleanup${RESET}
  clean        Remove Packer cache and Terraform local state
EOF
}

# --------------------------------------------------------------------------
# Main dispatcher
# --------------------------------------------------------------------------

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    help|--help|-h)      cmd_help ;;
    doctor)              cmd_doctor ;;
    packer-init)         cmd_packer_init ;;
    validate)            cmd_validate ;;
    build)               cmd_build ;;
    fmt)                 cmd_fmt ;;
    tf-init)             cmd_tf_init ;;
    tf-reinit)           cmd_tf_reinit ;;
    tf-ensure-init)      cmd_tf_ensure_init ;;
    tf-plan)             cmd_tf_plan ;;
    tf-apply)            cmd_tf_apply ;;
    tf-auto-apply)       cmd_tf_auto_apply ;;
    tf-destroy)          cmd_tf_destroy ;;
    tf-auto-destroy)     cmd_tf_auto_destroy ;;
    start)               cmd_start "$@" ;;
    stop)                cmd_stop "$@" ;;
    status)              cmd_status "$@" ;;
    wait-ready)          cmd_wait_ready "$@" ;;
    devbox-ssm)          cmd_devbox_ssm "$@" ;;
    devbox-port-forward) cmd_devbox_port_forward "$@" ;;
    jupyter)             cmd_jupyter "$@" ;;
    secrets-show)        cmd_secrets_show ;;
    clean)               cmd_clean ;;
    *)
      _error "Unknown command '${command}'. Run './run help' for usage."
      exit 1
      ;;
  esac
}

main "$@"
