# ansible-lint configuration for Phase 4 (CI-04)
#
# Source: RESEARCH §"Pattern 6" (lines 478-487) + upstream config reference
#         https://ansible.readthedocs.io/projects/lint/configuring/
#
# Profile policy: "production" is the strictest built-in profile and is
# appropriate for a CI gate. It enforces idempotency, fqcn, no-changed-when,
# and similar production-grade rules. Local pre-commit (plan 04-02) can
# inherit this file as-is.

profile: production

exclude_paths:
  - ansible/roles/AMAZON2023-CIS/   # vendored upstream role (Phase 0); do not lint third-party code
  - ansible/firewalld-docker-fix.yml # known workaround, documented in DOC-02 by plan 04-03 (see CLAUDE.md troubleshooting section once populated)
  - .planning/                      # planning markdown, not Ansible YAML
  - .github/                        # GitHub Actions workflows are YAML but not Ansible

# NOTE: `parseable` was removed from the ansible-lint config schema in v26 —
# with it present, ansible-lint 26.x exits 3 ("Invalid configuration file")
# before linting anything, which is what silently broke the CI job on every
# branch. Do not re-add it.

skip_list:
  # 99 pre-v26 findings. Two deliberate patterns: (a) dev_user/dev_home are a
  # cross-role contract (play vars in playbook.yml; per-role defaults are
  # standalone-use fallbacks) — role-prefixing them would break the sharing by
  # design; (b) role-local tool-version pins (mise_version, yq_version, …)
  # predate the rule. Renaming ~73 vars is churn without a safety win. New
  # roles SHOULD still prefix their private vars.
  - var-naming[no-role-prefix]

# Mock variables that come from facts/vault and are not statically resolvable
# during lint. (Empty by default — populate if/when production profile flags
# legitimate cases that cannot be fixed at the playbook level.)
mock_modules: []
mock_roles: []
