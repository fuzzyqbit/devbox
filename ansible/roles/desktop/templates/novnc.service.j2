[Unit]
Description=noVNC web client (proxying to VNC {{ desktop_vnc_display }})
After=vncserver.service
Requires=vncserver.service

[Service]
Type=simple
User={{ dev_user }}
Group={{ dev_user }}
Environment=HOME={{ dev_home }}

ExecStart=/usr/local/share/noVNC/utils/novnc_proxy \
  --listen {{ desktop_novnc_port }} \
  --vnc localhost:{{ desktop_vnc_port }} \
  --cert /etc/novnc/novnc-cert.pem \
  --key /etc/novnc/novnc-key.pem \
  --ssl-only

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
