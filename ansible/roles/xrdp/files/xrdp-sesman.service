# Source: instfiles/xrdp-sesman.service.in v0.10.6 [CITED: github.com/neutrinolabs/xrdp]
# @sbindir@ -> /usr/local/sbin (Phase 10 --prefix=/usr/local)
# @sysconfdir@ -> /etc (Phase 10 --sysconfdir=/etc)
[Unit]
Description=xrdp session manager
Documentation=man:xrdp-sesman(8) man:sesman.ini(5)
After=network.target
# Non-racing boot dependency (W2): the stop-when-unneeded directive and the reciprocal
# binds-to-xrdp directive were removed from this section. sesman is now pulled in
# independently at boot by WantedBy=multi-user.target below; ordering/dependency comes solely
# from xrdp.service's one-directional Requires=xrdp-sesman.service + After=...xrdp-sesman.service.
# The old reciprocal binding plus the stop-when-unneeded directive let systemd stop sesman at boot.

[Service]
Type=exec
EnvironmentFile=-/etc/sysconfig/xrdp
EnvironmentFile=-/etc/default/xrdp
ExecStart=/usr/local/sbin/xrdp-sesman $SESMAN_OPTIONS --nodaemon
ExecReload=kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
