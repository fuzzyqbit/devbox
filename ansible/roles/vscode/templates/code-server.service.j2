[Unit]
Description=code-server
After=network.target
# When the persistent-home layer is enabled, that role drops in a 10-require-home.conf that
# adds Requires=/After=devbox-home-mount.service (fail-closed on the persistent /home mount).

[Service]
Type=simple
User={{ dev_user }}
Group={{ dev_user }}
ExecStart=/usr/bin/code-server --bind-addr {{ code_server_bind_addr }}
Restart=on-failure
RestartSec=5
Environment=HOME={{ dev_home }}

[Install]
WantedBy=multi-user.target
