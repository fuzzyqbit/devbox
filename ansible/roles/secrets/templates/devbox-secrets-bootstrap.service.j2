[Unit]
Description=Fetch devbox secrets from SSM and apply to code-server / DCV
Wants=network-online.target
After=network-online.target cloud-final.service
Before=code-server.service dcvserver.service
ConditionPathExists=!/var/lib/devbox/secrets-applied

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/devbox-secrets-bootstrap.sh
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
