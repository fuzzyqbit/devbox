# Claude Code (local settings, not project files)
.claude/

# Per-operator AMI handoff tfvars written by `make packer-bake` (Terraform
# auto-loads from module dir; per-user file under users/ carries the just-built
# AMI ID). Also catches any per-operator tfvars an operator drops in to override
# CIDR allowlists, etc. — kept local, never committed.
*.auto.tfvars
users/*.auto.tfvars

# Root-level Terraform lock (occasionally synthesized by stray `tofu init`
# from the repo root; the canonical committed lock file lives at
# terraform/.terraform.lock.hcl)
.terraform.lock.hcl
