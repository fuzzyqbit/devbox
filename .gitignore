# Ansible
*.retry

# Per-bake SBOM artifact fetched back by ansible/sbom.yml (image copy lives at
# /etc/devimage-sbom.cdx.json). Local-only; archive elsewhere if needed.
sbom/

# OS
.DS_Store

# Claude Code (local settings + per-repo guide, not project files)
.claude/
CLAUDE.md

# Per-operator tfvars an operator drops in for their own overrides (CIDR
# allowlists, ami_id pins, etc.). Kept local, never committed.
*.auto.tfvars
users/*.auto.tfvars

# Root-level Terraform lock (occasionally synthesized by stray `tofu init`
# from the repo root; the canonical committed lock file lives at
# terraform/.terraform.lock.hcl)
.terraform.lock.hcl
