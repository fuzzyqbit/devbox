*.retry

# OS
.DS_Store

# Claude Code (local settings, not project files)
.claude/

# Root-level Terraform lock (terragrunt generates this at project root)
.terraform.lock.hcl

# Phase 3 (REP-05): per-operator AMI handoff tfvars written by `make packer-bake`.
# Terraform auto-loads `*.auto.tfvars` from its module dir; the per-user file
# under users/ carries the operator-of-record's just-built AMI ID. Gitignored
# because (a) it is generated by the Makefile, (b) it is per-operator state,
# (c) the AMI ID is not secret but is also not appropriate for committed code.
*.auto.tfvars
users/*.auto.tfvars
