packer/packer_cache/
*.pkr.hcl.lock

# Terraform
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfstate.d/
# (terraform.tfvars + backend.tf were previously gitignored as Terragrunt-generated
